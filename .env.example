# Optional. Public repositories work without a token (GitHub unauthenticated
# rate limit is 60 requests/hour). A personal access token raises the limit.
# Create a token at https://github.com/settings/tokens
# Milestone 1 only needs public-repo read access. Never commit a real token.
GITHUB_TOKEN=

# Override only for GitHub Enterprise or testing.
GITHUB_API_BASE_URL=https://api.github.com

# HTTP timeout in seconds for GitHub API calls.
GITHUB_REQUEST_TIMEOUT_SECONDS=30

# GitHub requires a User-Agent. Do not impersonate a browser.
REPOPILOT_USER_AGENT=RepoPilot-AI/0.1
